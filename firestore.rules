rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global safety net deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Reusable hardened primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBrainMode(mode) {
      return mode is string && mode.size() <= 32 && mode in [
        'adhd-turbo',
        'easy-read',
        'step-by-step',
        'exam-grind',
        'eli10',
        'academic',
        'teacher',
        'friend',
        'story'
      ];
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // Validation Blueprints (Pillar 2)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() <= 254 &&
        data.photoURL is string && data.photoURL.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClarifySession(data, userId, sessionId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'detectedTopic', 'brainMode', 'theGist',
          'madeSimple', 'examCheatcode', 'irlExample', 'extractedText',
          'clientCreatedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'detectedTopic', 'brainMode', 'theGist',
          'madeSimple', 'examCheatcode', 'irlExample', 'extractedText',
          'clientCreatedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == sessionId &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.detectedTopic is string && data.detectedTopic.size() >= 1 && data.detectedTopic.size() <= 200 &&
        isValidBrainMode(data.brainMode) &&
        data.theGist is string && data.theGist.size() <= 2000 &&
        data.madeSimple is list && data.madeSimple.size() <= 10 &&
        (data.madeSimple.size() == 0 || (data.madeSimple[0] is string && data.madeSimple[0].size() <= 600)) &&
        data.examCheatcode is string && data.examCheatcode.size() <= 1500 &&
        data.irlExample is string && data.irlExample.size() <= 1500 &&
        data.extractedText is string && data.extractedText.size() <= 4000 &&
        data.clientCreatedAt is string && data.clientCreatedAt.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFlashcard(data, userId, cardId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'question', 'answer', 'difficulty',
          'conceptTag', 'topic', 'clientCreatedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'question', 'answer', 'difficulty',
          'conceptTag', 'topic', 'clientCreatedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == cardId &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.question is string && data.question.size() >= 1 && data.question.size() <= 600 &&
        data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 1200 &&
        data.difficulty is string && data.difficulty.size() <= 16 && data.difficulty in ['Easy', 'Medium', 'Hard'] &&
        data.conceptTag is string && data.conceptTag.size() <= 120 &&
        data.topic is string && data.topic.size() <= 200 &&
        data.clientCreatedAt is string && data.clientCreatedAt.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConfidenceLog(data, userId, logId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'topic', 'level', 'difficulty',
          'clientTimestamp', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'topic', 'level', 'difficulty',
          'clientTimestamp', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == logId &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 200 &&
        data.level is string && data.level.size() <= 24 && data.level in ['not-yet', 'getting-there', 'got-it'] &&
        data.difficulty is string && data.difficulty.size() <= 24 && data.difficulty in ['easy', 'moderate', 'challenging'] &&
        data.clientTimestamp is string && data.clientTimestamp.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVoiceSession(data, userId, convId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'topicTag', 'brainMode',
          'turnsCount', 'summaryText', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'title', 'topicTag', 'brainMode',
          'turnsCount', 'summaryText', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == convId &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.topicTag is string && data.topicTag.size() <= 200 &&
        isValidBrainMode(data.brainMode) &&
        data.turnsCount is int && data.turnsCount >= 0 && data.turnsCount <= 500 &&
        data.summaryText is string && data.summaryText.size() <= 2000 &&
        data.clientUpdatedAt is string && data.clientUpdatedAt.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // PII-isolated learner profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);

      allow delete: if false;

      // Subcollection 1: Clarify Sessions
      match /clarifySessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(sessionId) &&
          isValidClarifySession(incoming(), userId, sessionId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(sessionId) &&
          isValidClarifySession(incoming(), userId, sessionId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().clientCreatedAt == existing().clientCreatedAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'detectedTopic', 'brainMode', 'theGist', 'madeSimple',
            'examCheatcode', 'irlExample', 'extractedText', 'updatedAt'
          ]);

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(sessionId) &&
          existing().ownerId == request.auth.uid;
      }

      // Subcollection 2: Flashcards
      match /flashcards/{cardId} {
        allow get: if isOwner(userId) && isValidId(cardId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(cardId) &&
          isValidFlashcard(incoming(), userId, cardId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(cardId) &&
          isValidFlashcard(incoming(), userId, cardId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().clientCreatedAt == existing().clientCreatedAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'question', 'answer', 'difficulty', 'conceptTag', 'topic', 'updatedAt'
          ]);

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(cardId) &&
          existing().ownerId == request.auth.uid;
      }

      // Subcollection 3: Confidence Logs
      match /confidenceLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(logId) &&
          isValidConfidenceLog(incoming(), userId, logId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(logId) &&
          isValidConfidenceLog(incoming(), userId, logId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().clientTimestamp == existing().clientTimestamp &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'level', 'difficulty', 'updatedAt']);

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(logId) &&
          existing().ownerId == request.auth.uid;
      }

      // Subcollection 4: Voice Sessions
      match /voiceSessions/{convId} {
        allow get: if isOwner(userId) && isValidId(convId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(convId) &&
          isValidVoiceSession(incoming(), userId, convId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(convId) &&
          isValidVoiceSession(incoming(), userId, convId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'topicTag', 'brainMode', 'turnsCount', 'summaryText', 'clientUpdatedAt', 'updatedAt'
          ]);

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(convId) &&
          existing().ownerId == request.auth.uid;
      }
    }
  }
}
